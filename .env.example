# Desenvolvimento: /api é encaminhado pelo Vite para a API Spring.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:8080
# Offset usado pelo servidor Java para seus LocalDateTime (confirmar no ambiente).
VITE_API_UTC_OFFSET=-03:00
# Produção: URL pública completa terminando em /api, ou reverse proxy em /api.
# Nunca coloque JWT_SECRET, senha do banco ou outro segredo em VITE_*.
